---
import { site } from '../site'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const { colors } = site
// The palette as CSS custom properties (--accent, --accentDeep, ...), set on <html>.
const palette = Object.entries(colors).map(([name, value]) => `--${name}: ${value}`).join('; ')
---
<!doctype html>
<html lang="en" style={palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={colors.accent} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('og-image.png', site.appUrl)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap topbar">
      <a class="brand" href="/"><img src="/icon-192.png" alt="" width="28" height="28" />{site.name}</a>
      <a class="button" href={site.appUrl}>{site.cta}</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap">
      <span>© {new Date().getFullYear()} {site.owner}</span>
      <nav aria-label="Legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms &amp; Conditions</a>
        {site.contactEmail && <a href={`mailto:${site.contactEmail}`}>Contact</a>}
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
  a { color: var(--accentDeep); }
  img { max-width: 100%; height: auto; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .wrap { width: min(1100px, calc(100% - 40px)); margin-inline: auto; }
  .skip { position: absolute; left: -999px; top: 12px; background: var(--paper); padding: 8px 12px; }
  .skip:focus { left: 12px; }
  .topbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 20px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 800; font-size: 1.1rem; text-decoration: none; }
  .brand img { border-radius: 7px; }
  .button { display: inline-block; background: var(--accentDeep); color: #fff; border-radius: 8px; padding: 12px 20px; font-weight: 700; text-decoration: none; }
  .button:hover { filter: brightness(1.1); }
  .eyebrow { margin: 0 0 12px; color: var(--accentDeep); font-size: .75rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  h1, h2, h3 { line-height: 1.15; letter-spacing: -.02em; }
  footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding-block: 40px; border-top: 1px solid #0000001a; color: var(--muted); font-size: .9rem; }
  footer nav { display: flex; flex-wrap: wrap; gap: 20px; }
  .legal { max-width: 720px; padding-block: 32px 64px; }
  .legal h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 8px; }
  .legal h2 { font-size: 1.25rem; margin: 36px 0 8px; }
  .legal .updated { color: var(--muted); margin: 0 0 24px; }
</style>
